{
  "manifest_version": 3,
  "name": "IP定位",
  "version": "1.1.1",
  "description": "基于IP位置自动更新浏览器的GPS位置。",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
